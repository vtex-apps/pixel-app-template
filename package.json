{
  "name": "YOURAPPNAME",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "lint": "eslint --ext js,jsx,ts,tsx .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@vtex/prettier-config": "^0.1.4",
    "eslint": "^6.8.0",
    "eslint-config-vtex": "^12.3.2",
    "eslint-config-vtex-react": "^6.3.2",
    "husky": "^4.2.3",
    "lint-staged": "^10.1.1",
    "prettier": "^2.0.2",
    "typescript": "^3.8.3"
  },
  "resolutions": {
    "ansi-regex": "5.0.1",
    "brace-expansion": "1.1.22",
    "braces": "3.0.3",
    "flatted": "3.4.4",
    "js-yaml": "3.15.2",
    "json5": "2.2.3",
    "lodash": "4.18.1",
    "minimatch": "3.1.5",
    "minimist": "1.2.8",
    "picomatch": "2.3.2",
    "tmp": "0.2.7"
  }
}
